# ============================================================
# 证析 EvidenceFlow — 环境变量模板
# 复制为 .env.local 后填写；.env.local 已被 .gitignore 忽略
# ============================================================

# 服务端口
PORT=3000

# 无 Key 时是否使用内置示例数据（true = 可离线演示）
DEMO_MODE=true

# 是否允许在「设置」页面输入临时 Key（仅存 sessionStorage，不落盘）
# 公网部署建议设为 false，只使用服务端环境变量
ALLOW_CLIENT_KEY=true

# ---------- 评审登录（可选） ----------
# true = 分析自定义材料必须先登录；示例案例不需要登录
AUTH_REQUIRED=false
# 不设置时，评审账号默认 review@evidenceflow.local / EvidenceFlow2026
# 评审账号支持邮箱；普通注册仍要求 11 位手机号
# 正式部署请改成自己的账号密码
REVIEW_USERNAME=
REVIEW_PASSWORD=
# HTTPS 部署时设为 true，Cookie 加 Secure
COOKIE_SECURE=false
# 用户数据目录（默认项目根目录/data）
# DATA_DIR=./data

# ---------- 文本大模型（DeepSeek / OpenAI 兼容） ----------
# 官方地址：https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- 视觉模型（可选，用于图表截图/图片识别） ----------
# 例如通义千问 VL、GLM-4V、Gemini Flash；留空则图片入口自动降级
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# ---------- 可选：行业基准知识库路径 ----------
# 默认使用 server/knowledge/benchmarks.ts 内置知识库
